NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — get from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ID for the $25/mo brand platform subscription
# Create the recurring product in Stripe and paste the price_... id here.
STRIPE_BRAND_SUBSCRIPTION_PRICE_ID=price_...

# Public site URL (used for Checkout/Connect redirect URLs).
# In dev: http://localhost:3000 — in prod: your deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform fee on creator payouts (0.05 = 5%)
PLATFORM_FEE_RATE=0.05

# Resend — transactional email. Sign up at https://resend.com,
# verify your sending domain, then create an API key.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Shared secret for the Supabase Database Webhook that calls
# /api/notifications/email. Generate with: openssl rand -hex 32
# Paste the same value into the webhook's x-webhook-secret header.
SUPABASE_WEBHOOK_SECRET=replace-with-long-random-string

# Comma-separated list of emails allowed to view internal admin pages
# (e.g. /admin/onboarding). Match is case-insensitive.
ADMIN_EMAILS=you@example.com

# Secret for cron job endpoints (brand reminders, etc.).
# Generate with: openssl rand -hex 32
# Pass as x-cron-secret header when calling /api/brand-reminders.
CRON_SECRET=replace-with-long-random-string

# TikTok Login Kit + Display API — get from https://developers.tiktok.com/apps
# Used by creators to connect their TikTok account for Program video tracking.
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Apify — OAuth-free TikTok metrics, used by /api/programs/apify-sync and the
# brand dashboard's "Track Accounts" dialog. This is the stopgap while the
# TikTok app is still pending app review (the Display API above needs each
# creator to authorize the app, which only works after approval).
# Get a token at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=apify_api_...
